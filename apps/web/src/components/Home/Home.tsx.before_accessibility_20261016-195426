function asObject(value: unknown): Record<string, unknown> | null {
  if (value && typeof value === 'object' && !Array.isArray(value)) {
    return value as Record<string, unknown>;
  }

  return null;
}

function getMessage(value: unknown, fallback = 'Request completed.'): string {
  const obj = asObject(value);

  if (!obj) {
    return typeof value === 'string' ? value : fallback;
  }

  const message =
    obj.message ??
    obj.detail ??
    obj.output ??
    obj.result ??
    obj.status ??
    obj.description;

  if (typeof message === 'string') {
    return message;
  }

  if (message && typeof message === 'object') {
    return getMessage(message, fallback);
  }

  return fallback;
}

function findFileItems(value: unknown, depth = 0): FileItem[] {
  if (depth > 5 || value == null) {
    return [];
  }

  if (Array.isArray(value)) {
    return value
      .map((item): FileItem | null => {
        if (typeof item === 'string') {
          return {
            name: item.split('/').pop() || item,
            path: item,
          };
        }

        const obj = asObject(item);

        if (!obj) {
          return null;
        }

        const path = [
          obj.path,
          obj.full_path,
          obj.absolute_path,
          obj.file_path,
          obj.location,
        ].find((entry): entry is string => typeof entry === 'string');

        const name = [
          obj.name,
          obj.filename,
          obj.file_name,
        ].find((entry): entry is string => typeof entry === 'string');

        if (!path && !name) {
          return null;
        }

        const finalPath = path || name || '';

        return {
          name: name || finalPath.split('/').pop() || finalPath,
          path: finalPath,
          type:
            typeof obj.type === 'string'
              ? obj.type
              : typeof obj.kind === 'string'
                ? obj.kind
                : undefined,
          preview:
            typeof obj.preview === 'string'
              ? obj.preview
              : typeof obj.snippet === 'string'
                ? obj.snippet
                : typeof obj.content_preview === 'string'
                  ? obj.content_preview
                  : undefined,
        };
      })
      .filter((item): item is FileItem => item !== null);
  }

  const obj = asObject(value);

  if (!obj) {
    return [];
  }

  for (const key of [
    'matches',
    'files',
    'items',
    'results',
    'entries',
    'data',
    'result',
  ]) {
    if (obj[key] !== undefined) {
      const found = findFileItems(obj[key], depth + 1);

      if (found.length) {
        return found;
      }
    }
  }

  return [];
}

function getHostname(url: string): string {
  try {
    return new URL(url).hostname;
  } catch {
    return url;
  }
}

function normalizeUrl(text: string): string | null {
  const match = text.match(
    /https?:\/\/[^\s"'<>]+|(?:www\.)?[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)+(?:\/[^\s"'<>]*)?/i,
  );

  if (!match) {
    return null;
  }

  let url = match[0].replace(/[.,!?;]+$/, '');

  if (!/^https?:\/\//i.test(url)) {
    url = `https://${url}`;
  }

  try {
    return new URL(url).toString();
  } catch {
    return null;
  }
}


function detectIntent(input: string) {
  const text = input.trim();
  const url = normalizeUrl(text);

  // Website QA
  const hasWebsiteTest =
    /\b(test|check|qa|audit|inspect)\b/i.test(text) &&
    Boolean(url);

  if (hasWebsiteTest) {
    return { type: 'website' as const, url };
  }

  // PC / system information
  const isPCStatus =
    /\b(pc status|system status|system info|system information|pc info|computer status|hardware status|show my pc|my system)\b/i.test(text);

  if (isPCStatus) {
    return { type: 'system' as const };
  }

  // Explicit content search must be checked BEFORE filename search.
  const contentPatterns = [
    // Search files with Auralink
    /^(?:please\s+)?(?:search|find|look for)\s+(?:all\s+)?files?\s+(?:with|containing|that contain|mentioning)\s+(.+)$/i,

    // Search operating system files for paging
    /^(?:please\s+)?(?:search|find|look for)\s+(.+?)\s+files?\s+for\s+(.+)$/i,

    // Search resume for operating system
    /^(?:please\s+)?(?:search|find|look for)\s+(?:the\s+)?(resumes?|cvs?)\s+for\s+(.+)$/i,

    // Search inside files for paging
    /^(?:please\s+)?(?:search inside|search within|search content|find text)\s+(.+)$/i,

    // Find text Auralink inside files
    /^(?:please\s+)?find text\s+(.+?)\s+inside files?$/i,

    // Find a phrase in file contents
    /^(?:please\s+)?(?:find|search for)\s+(.+?)\s+in\s+(?:the\s+)?(?:file contents|file content|documents?)$/i,
  ];

  for (const pattern of contentPatterns) {
    const match = text.match(pattern);

    if (!match) continue;

    let query = text;

    // Category + content query
    if (
      pattern === contentPatterns[1] ||
      pattern === contentPatterns[2]
    ) {
      query = text;
    } else {
      query = text;
    }

    return {
      type: 'content' as const,
      query,
    };
  }

  // Open / launch a file or folder
  const isOpen =
    /^(?:please\s+)?(?:open|launch|show|khol|kholo|khul)\b/i.test(text) ||
    /\b(?:open|kholo|khol|khul)\s+(?:the\s+)?(?:file|folder)\b/i.test(text) ||
    /\b(?:latest|last|newest|most recent)\b.*\b(file|folder|document|pdf)\b.*\b(open|kholo|khol|khul)\b/i.test(text);

  if (isOpen) {
    const query = text
      .replace(/\b(open|launch|show|khol|kholo|khul)\b/gi, ' ')
      .replace(/\b(please|the|file|folder|kar|do|krr|latest|last|newest|recent)\b/gi, ' ')
      .replace(/\s+/g, ' ')
      .trim();

    return {
      type: 'open' as const,
      query: query || text,
    };
  }

  // General content searches
  const isContentSearch =
    /\b(search inside|search within|inside files|in file contents|search content|find text|find function|find code|search for|where is|look for)\b/i.test(text);

  if (isContentSearch) {
    const query = text
      .replace(
        /^(please\s+)?(search inside|search within|inside files|in file contents|search content|find text|find function|find code|search for|find|where is|look for)\s*/i,
        '',
      )
      .replace(
        /\b(in my project|in the project|inside my project|inside the project|in files|inside files)\b/gi,
        '',
      )
      .trim();

    return {
      type: 'content' as const,
      query: query || text,
    };
  }


  // Search inside resume/CV files using any user-provided term.
  const resumeContentMatch = text.match(
    /^(?:please\s+)?(?:search|find|look for)\s+(?:the\s+)?(resume|resumes|cv|cvs)\s+(?:for|with|containing|mentioning)\s+(.+)$/i,
  );

  if (resumeContentMatch) {
    return {
      type: 'content' as const,
      query: text,
    };
  }


  // Filename / folder search
  const isFileSearch =
    /\b(find|search|locate|list|show|dikha|dikhao|dikhaye|bata|batao|de|do|nikal|nikaal|dhoondh|dhundh|dhundho|khoj)\b/i.test(text) &&
    /\b(file|files|folder|folders|document|documents|resume|resumes|cv|cvs|pdf|python|javascript|typescript|css|html|json|tsx|ts|jsx|js|py|md)\b/i.test(text);

  if (isFileSearch) {
    const query = text
      .replace(
        /\b(please|mujhe|mera|meri|mere|saari|saare|sari|sare|sabhi|sab|all|my|the|for|find|search|locate|list|show|give|me|de|do|dikha|dikhao|dikhaye|bata|batao|dhoondh|dhundh|dhundho|khoj|nikaal|nikal|files|file|folders|folder|documents|document|resumes|resume|cvs|cv|in my pc|on my pc|on my computer)\b/gi,
        ' ',
      )
      .replace(/\s+/g, ' ')
      .trim();

    return {
      type: 'files' as const,
      query: query || text,
    };
  }

  // Short/general file-related requests, including "resume"
  const soundsLikeFileRequest =
    /\b(file|files|folder|folders|document|documents|code|source code|project file|resume|resumes|cv|cvs|pdf|tsx|jsx|typescript|javascript)\b/i.test(text) ||
    /\b(dhoondh|dhundh|dhundho|dikha|dikhao|bata|batao|de do|nikal|nikaal|khoj)\b/i.test(text);

  if (soundsLikeFileRequest) {
    const query = text
      .replace(
        /\b(please|mujhe|mera|meri|mere|saari|saare|sari|sare|sabhi|sab|all|my|the|for|find|search|locate|list|show|give|me|de|do|dikha|dikhao|dikhaye|bata|batao|dhoondh|dhundh|dhundho|khoj|nikaal|nikal|wali|wala|waali|waala|files|file|folders|folder|documents|document|resumes|resume|cvs|cv|in my pc|on my pc|on my computer)\b/gi,
        ' ',
      )
      .replace(/\s+/g, ' ')
      .trim();

    return {
      type: 'files' as const,
      query: query || text,
    };
  }

  // Fallback: send other commands to the local agent.
  return {
    type: 'command' as const,
    command: text,
  };
}


async function requestJSON(
  url: string,
  options?: RequestInit,
): Promise<unknown> {
  const response = await fetch(url, options);
  const text = await response.text();

  let body: unknown;

  try {
    body = text ? JSON.parse(text) : {};
  } catch {
    body = text;
  }

  if (!response.ok) {
    throw new Error(
      getMessage(body, `Request failed (${response.status})`),
    );
  }

  return body;
}

function getResultMessage(value: unknown, fallback: string): string {
  const obj = asObject(value);

  if (!obj) {
    return typeof value === 'string' ? value : fallback;
  }

  const candidates = [
    obj.message,
    obj.detail,
    obj.output,
    obj.description,
    obj.status,
  ];

  for (const candidate of candidates) {
    if (typeof candidate === 'string' && candidate.trim()) {
      return candidate;
    }
  }

  return fallback;
}

